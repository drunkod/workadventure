# Server Information
DEBUG_MODE=true
SERVER_NAME=MockServer

# Mandatory variables for Pusher/Backend mock
SECRET_KEY=localDevSecret123
API_URL=localhost:50051
MAP_STORAGE_API_TOKEN=dummy_token
UPLOADER_URL=http://localhost:8080
ICON_URL=http://localhost:8080

# Back server configuration (required by Back server)
PLAY_URL=http://127.0.0.1:3000

VITE_URL=http://127.0.0.1:8080
FRONT_URL=http://127.0.0.1:8080
PUSHER_URL=/

# Pusher HTTP server port (separate from Vite dev server)
PUSHER_HTTP_PORT=3000

# Pusher WebSocket port (Workaround for local dev)
PUSHER_WS_PORT=3001

# Disable external services
DISABLE_ANONYMOUS=false
DISABLE_NOTIFICATIONS=true
ENABLE_CHAT=false
ENABLE_CHAT_UPLOAD=false

# Use local Jitsi (public test server)
JITSI_URL=meet.jit.si
JITSI_PRIVATE_MODE=false

# Feature flags - disable heavy features
ENABLE_MAP_EDITOR=true
ENABLE_REPORT_ISSUES_MENU=false

# Integration tools - enable YouTube for testing
YOUTUBE_ENABLED=true
KLAXOON_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DOCS_ENABLED=false
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SLIDES_ENABLED=false
ERASER_ENABLED=false
EXCALIDRAW_ENABLED=false
CARDS_ENABLED=false
TLDRAW_ENABLED=false

# Use local maps
START_ROOM_URL=/_/global/127.0.0.1:8080/maps/starter/map.json
